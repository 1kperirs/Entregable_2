<main class="chat">

  <header class="chat__header">
    <div>
      <h1 class="chat__titulo">💬 Chat en vivo</h1>
      <p class="chat__sub">Los mensajes se ven para todos los conectados</p>
    </div>
    <span class="chat__online"><span class="punto"></span> <span id="conectados">{{conectados}}</span> en línea</span>
  </header>

  {{!-- Lista de mensajes (los que ya existen se pintan desde el servidor) --}}
  <ul class="chat__mensajes" id="listaMensajes">
    {{#each mensajes}}
      {{> mensaje}}
    {{else}}
      <li class="chat__vacio" id="vacio">Aún no hay mensajes. ¡Escribe el primero! ✨</li>
    {{/each}}
  </ul>

  {{!-- Formulario --}}
  <form class="chat__form" id="formChat" autocomplete="off">
    <div class="chat__fila">
      <div class="campo">
        <label for="nombre">Nombre</label>
        <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" maxlength="30" required>
      </div>
      <div class="campo">
        <label for="publicidad">Publicidad</label>
        <input type="text" id="publicidad" name="publicidad" placeholder="Ej: 20% OFF hoy (opcional)" maxlength="60">
      </div>
    </div>

    <div class="campo campo--mensaje">
      <label for="mensaje">Mensaje</label>
      <div class="chat__enviar">
        <textarea id="mensaje" name="mensaje" rows="1" placeholder="Escribe un mensaje..." maxlength="500" required></textarea>
        <button type="submit" class="btn" aria-label="Enviar">
          <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
        </button>
      </div>
    </div>
  </form>

</main>

{{!-- Plantilla del lado del cliente para los mensajes nuevos que llegan en vivo.
      El "\" evita que el servidor la procese: llega intacta al navegador. --}}
<script id="tplMensaje" type="text/x-handlebars-template">
  <li class="msg \{{#if propio}}msg--propio\{{/if}}">
    <div class="msg__avatar">\{{inicial}}</div>
    <div class="msg__burbuja">
      <div class="msg__cabecera">
        <span class="msg__autor">\{{#if propio}}Tú\{{else}}\{{nombre}}\{{/if}}</span>
        <time class="msg__hora">\{{hora}}</time>
      </div>
      \{{#if publicidad}}<span class="msg__publicidad">📢 \{{publicidad}}</span>\{{/if}}
      <p class="msg__texto">\{{mensaje}}</p>
    </div>
  </li>
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/handlebars.js/4.7.8/handlebars.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/chat.js"></script>
